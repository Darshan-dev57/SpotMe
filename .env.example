# SpotMe settings, with values that work for a local run (scripts/start.sh sets the same ones). Spring Boot reads these from the environment; to use a file, copy it to .env (git
# ignores it) and load it before starting the app:  set -a; source .env; set +a
# Any other spotme.* key in backend/src/main/resources/application.properties works the same way,
# for example spotme.worker.threads -> SPOTME_WORKER_THREADS.

# Database (docker-compose.yml starts PostgreSQL with pgvector on localhost:5434)
SPOTME_DB_URL=jdbc:postgresql://localhost:5434/spotme
SPOTME_DB_USER=spotme
SPOTME_DB_PASSWORD=spotme

# HTTP port of the app
PORT=8080

# Address guest invite links point to: where you open the app
SPOTME_WEB_ORIGIN=http://localhost:8080
# Folder with the built web UI (web/out). Empty = API only, run the UI with npm run dev
SPOTME_WEB_DIR=../web/out

# Secret that signs photo links. Empty = a random one at every start (links stop working after a restart).
# In production set a long random value and keep it out of git.
SPOTME_MEDIA_SECRET=

# Face models (scripts/fetch-models.sh downloads them here)
SPOTME_MODELS_DIR=../models

# Photo storage: local (files under SPOTME_STORAGE_DIR) or s3 (a bucket, see docs/STORAGE.md)
SPOTME_STORAGE_TYPE=local
SPOTME_STORAGE_DIR=../data/storage
# Only used when SPOTME_STORAGE_TYPE=s3. The values below match the minio service in docker-compose.yml
# and are for local use only.
SPOTME_S3_ENDPOINT=http://localhost:9000
SPOTME_S3_REGION=us-east-1
SPOTME_S3_BUCKET=spotme-photos
SPOTME_S3_ACCESS_KEY=spotme
SPOTME_S3_SECRET_KEY=spotme-minio

# Indexing worker in the same process (false when a separate worker process runs with the worker profile)
SPOTME_WORKER_ENABLED=true
SPOTME_WORKER_THREADS=2

# Public sample event anyone can try (off by default)
SPOTME_SAMPLE_ENABLED=false
SPOTME_SAMPLE_PHOTOSDIR=../data/sample-photos

# Logs as JSON lines (empty = plain text)
LOGGING_STRUCTURED_FORMAT_CONSOLE=
